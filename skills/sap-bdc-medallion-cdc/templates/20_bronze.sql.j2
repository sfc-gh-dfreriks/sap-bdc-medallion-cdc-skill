/* ============================================================================
   20  Bronze — pass-through views onto the share
   ----------------------------------------------------------------------------
   Generated by sap-bdc-medallion-cdc from {{ config_name }}.

   There is no Bronze TABLE, and that is the point. SAP has already landed the
   data as Iceberg and shared it zero-copy; copying it would pay twice for one
   dataset, add a hop of latency — and is actively unsafe: on a reference
   tenant the connector metadata columns were clean inside every live
   catalog-linked database and corrupted on every local copy made from one.
   So capture points at {{ src.database }} itself, always.

   The views are a naming contract:
     - the share's identifiers are mixed/lower case, so quoting happens once here
{%- if src.track == 'STANDARD' %}
     - load_type_<hash> / run_id_<hash> become LOAD_TYPE / RUN_ID, so a
       re-publish (new hash) is a re-render of this file, not an edit everywhere
     - CDC_TIMESTAMP_UTC is exposed parsed, for display only. "__TIMESTAMP" stays
       raw TEXT because comparisons must stay in text: MAX() over the raw column
       is answered from Iceberg manifest statistics; MAX() over a parsed
       expression reads the object. It arrives with a COMMA decimal separator,
       so it is REPLACEd before parsing — an unguarded cast returns NULL silently.
{%- else %}
     - CDC_TIMESTAMP_UTC is the custom-track replication timestamp
       ("{{ src.watermark_column }}"), cast to TIMESTAMP_NTZ.
{%- endif %}

   Schema evolution: SELECT * fixes the column list when the view is created.
   If SAP adds columns to the product, re-run this file.
   ========================================================================== */

USE DATABASE {{ T }};
{% for o in objects %}
CREATE OR REPLACE VIEW BRONZE.V_{{ o.name }}
  COMMENT = 'Zero-copy view on {{ o.source_fqn | sqlstr }}. Grain: {{ o.key_cols | join(", ") }}.{{ " Empty at deployment." if o.cls == "EMPTY" }}'
AS
{%- if src.track == 'STANDARD' %}
SELECT * RENAME ("{{ src.load_type_col }}" AS LOAD_TYPE,
                 "{{ src.run_id_col }}" AS RUN_ID),
       TRY_TO_TIMESTAMP_NTZ(REPLACE("__TIMESTAMP", ',', '.')) AS CDC_TIMESTAMP_UTC
{%- else %}
SELECT *,
       "{{ src.watermark_column }}"::TIMESTAMP_NTZ AS CDC_TIMESTAMP_UTC
{%- endif %}
FROM {{ o.source_fqn }};
{% endfor %}

/* ---------------------------------------------------------------------------
   What the share currently carries, per object, with the change mix. Reads the
   watermark as text so it stays cheap.
   --------------------------------------------------------------------------- */
CREATE OR REPLACE VIEW BRONZE.VW_SHARE_INVENTORY
  COMMENT = 'Row counts and change mix per shared object, straight from the share.'
AS
{%- for o in objects %}
SELECT '{{ o.name }}' AS OBJECT_NAME,
{%- if src.track == 'STANDARD' %}
       "__OPERATION_TYPE" AS OPERATION, LOAD_TYPE,
{%- else %}
       NULL::VARCHAR AS OPERATION, NULL::VARCHAR AS LOAD_TYPE,
{%- endif %}
       COUNT(*) AS ROWS_, MIN({{ o.wm_text_expr }}) AS FIRST_SEEN, MAX({{ o.wm_text_expr }}) AS LAST_SEEN
FROM BRONZE.V_{{ o.name }} GROUP BY 1, 2, 3
{{- "\nUNION ALL" if not loop.last else ";" }}
{%- endfor %}
