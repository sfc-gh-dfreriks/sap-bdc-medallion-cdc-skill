/* ============================================================================
   10  Database, schemas and the capture control plane
   ----------------------------------------------------------------------------
   Generated by sap-bdc-medallion-cdc from {{ config_name }}.
   Source : {{ src.database }}.{{ src.schema_q }}  ({{ src.track }} track)
   Target : {{ T }}

   Idempotent. Holds no data of its own beyond capture state. Run it first.

   Why a control plane at all: the objects in a catalog-linked database are
   Iceberg tables on an external catalog, so streams, CHANGES() and change
   tracking are all refused by the platform. What remains is a replication
   watermark SAP already writes, plus dynamic tables. Neither records what has
   already been seen, so this schema does.

   The registry stores column names and poll expressions as DATA rather than
   code. On the standard track two connector columns carry a 32-hex flow hash
   in their name (load_type_<hash>, run_id_<hash>); the hash changes when the
   product is re-published, so SQL that spells it inline breaks silently.
   ========================================================================== */

CREATE DATABASE IF NOT EXISTS {{ T }}
  COMMENT = 'Medallion + CDC over the {{ src.database }} SAP BDC catalog-linked share.';

CREATE SCHEMA IF NOT EXISTS {{ T }}.CAPTURE_CONTROL
  COMMENT = 'Watermark state, metadata validation, refresh audit, reconciliation.';
CREATE SCHEMA IF NOT EXISTS {{ T }}.BRONZE
  COMMENT = 'Pass-through views onto the share. No copy of the data is made.';
CREATE SCHEMA IF NOT EXISTS {{ T }}.SILVER
  COMMENT = 'Typed, de-duplicated, incrementally refreshed dynamic tables.';
CREATE SCHEMA IF NOT EXISTS {{ T }}.GOLD
  COMMENT = 'Conformed dimensions and consumption marts.';


/* ---------------------------------------------------------------------------
   The object registry. One row per source object.

   MERGE_KEY_COLUMNS is the full grain. A catalog-linked table declares no
   primary key, so every key below must have been VERIFIED (rows = distinct key
   combinations) with scripts/verify_grain.py — never inferred from column
   order. A short key does not error; it silently collapses rows.
   --------------------------------------------------------------------------- */
CREATE TABLE IF NOT EXISTS {{ T }}.CAPTURE_CONTROL.WATERMARK (
  OBJECT_NAME         VARCHAR NOT NULL,
  SOURCE_FQN          VARCHAR NOT NULL,
  TRACK               VARCHAR NOT NULL,   -- STANDARD | CUSTOM
  WATERMARK_COLUMN    VARCHAR NOT NULL,   -- __TIMESTAMP (standard) | e.g. ZZLASTCHGDATE (custom)
  POLL_MAX_EXPR       VARCHAR NOT NULL,   -- aggregate returning the watermark as sortable TEXT
  POLL_MIN_EXPR       VARCHAR NOT NULL,
  OPERATION_COLUMN    VARCHAR,            -- __OPERATION_TYPE (standard only)
  LOAD_TYPE_COLUMN    VARCHAR,            -- load_type_<flow hash> (standard only)
  RUN_ID_COLUMN       VARCHAR,            -- run_id_<flow hash> (standard only)
  MERGE_KEY_COLUMNS   VARCHAR NOT NULL,   -- verified full grain, comma separated
  TARGET_DT           VARCHAR,
  OBJECT_CLASS        VARCHAR,            -- MASTER | TRANSACTION | EMPTY
  LAST_WATERMARK_TEXT VARCHAR,            -- as seen on the share, unparsed
  LAST_WATERMARK      TIMESTAMP_NTZ,      -- parsed, for display only
  LAST_RUN_STARTED    TIMESTAMP_NTZ,
  LAST_RUN_STATUS     VARCHAR,
  UPDATED_AT          TIMESTAMP_NTZ,
  CONSTRAINT PK_WATERMARK PRIMARY KEY (OBJECT_NAME)
);

/* MERGE so re-running neither duplicates rows nor resets advanced watermarks. */
MERGE INTO {{ T }}.CAPTURE_CONTROL.WATERMARK t
USING (
  SELECT * FROM VALUES
{%- for o in objects %}
    ('{{ o.name }}', '{{ o.source_fqn }}', '{{ o.key_cols | join(",") }}', '{{ o.cls }}',
     '{{ o.poll_max_expr | sqlstr }}', '{{ o.poll_min_expr | sqlstr }}'){{ "," if not loop.last }}
{%- endfor %}
  AS v(OBJECT_NAME, SOURCE_FQN, MERGE_KEY_COLUMNS, OBJECT_CLASS, POLL_MAX_EXPR, POLL_MIN_EXPR)
) s
ON t.OBJECT_NAME = s.OBJECT_NAME
WHEN MATCHED THEN UPDATE SET
  t.SOURCE_FQN        = s.SOURCE_FQN,
  t.MERGE_KEY_COLUMNS = s.MERGE_KEY_COLUMNS,
  t.OBJECT_CLASS      = s.OBJECT_CLASS,
  t.POLL_MAX_EXPR     = s.POLL_MAX_EXPR,
  t.POLL_MIN_EXPR     = s.POLL_MIN_EXPR,
  t.LOAD_TYPE_COLUMN  = {{ "'" ~ src.load_type_col ~ "'" if src.load_type_col else "NULL" }},
  t.RUN_ID_COLUMN     = {{ "'" ~ src.run_id_col ~ "'" if src.run_id_col else "NULL" }},
  t.UPDATED_AT        = SYSDATE()
WHEN NOT MATCHED THEN INSERT
  (OBJECT_NAME, SOURCE_FQN, TRACK, WATERMARK_COLUMN, POLL_MAX_EXPR, POLL_MIN_EXPR,
   OPERATION_COLUMN, LOAD_TYPE_COLUMN, RUN_ID_COLUMN, MERGE_KEY_COLUMNS, TARGET_DT,
   OBJECT_CLASS, LAST_RUN_STATUS, UPDATED_AT)
  VALUES
  (s.OBJECT_NAME, s.SOURCE_FQN, '{{ src.track }}', '{{ src.watermark_column }}',
   s.POLL_MAX_EXPR, s.POLL_MIN_EXPR,
   {{ "'" ~ src.operation_column ~ "'" if src.operation_column else "NULL" }},
   {{ "'" ~ src.load_type_col ~ "'" if src.load_type_col else "NULL" }},
   {{ "'" ~ src.run_id_col ~ "'" if src.run_id_col else "NULL" }},
   s.MERGE_KEY_COLUMNS,
   IFF(s.OBJECT_CLASS = 'EMPTY', NULL, '{{ T }}.SILVER.DT_' || s.OBJECT_NAME),
   s.OBJECT_CLASS, 'REGISTERED', SYSDATE());


/* ---------------------------------------------------------------------------
   Metadata validation results. Thresholds come from a measured contrast: in a
   live catalog-linked share the operation column held 2 distinct values of 1
   character; on local COPIES of the same products it held 17 values up to 33
   characters, and once the operation, timestamp and load_type columns all held
   the same customer identifier on every row. None of that errors.
   --------------------------------------------------------------------------- */
CREATE TABLE IF NOT EXISTS {{ T }}.CAPTURE_CONTROL.METADATA_VALIDATION (
  CHECKED_AT        TIMESTAMP_NTZ DEFAULT SYSDATE(),
  OBJECT_NAME       VARCHAR,
  SOURCE_FQN        VARCHAR,
  TRACK             VARCHAR,
  TOTAL_ROWS        NUMBER,
  OPERATION_CARD    NUMBER,
  OPERATION_MAX_LEN NUMBER,
  TIMESTAMPS_PARSED NUMBER,
  DEGENERATE_ROWS   NUMBER,
  HASH_SUFFIX_SEEN  BOOLEAN,
  VERDICT           VARCHAR,
  FAULTS            VARCHAR
);

/* Dynamic-table refresh history is retained for a limited window, so the
   verdicts that matter are snapshotted into a table this schema owns. */
CREATE TABLE IF NOT EXISTS {{ T }}.CAPTURE_CONTROL.REFRESH_AUDIT (
  CAPTURED_AT     TIMESTAMP_NTZ DEFAULT SYSDATE(),
  TARGET_DT       VARCHAR,
  REFRESH_ACTION  VARCHAR,     -- INCREMENTAL | FULL | NO_DATA
  STATE           VARCHAR,
  REFRESH_START   TIMESTAMP_LTZ,
  REFRESH_END     TIMESTAMP_LTZ,
  DURATION_MS     NUMBER
);

/* Row-count reconciliation. Not optional: no delete code has been confirmed on
   either track, so a hard delete in SAP that the share does not express is only
   visible as a count difference. */
CREATE TABLE IF NOT EXISTS {{ T }}.CAPTURE_CONTROL.RECONCILIATION (
  CHECKED_AT      TIMESTAMP_NTZ DEFAULT SYSDATE(),
  OBJECT_NAME     VARCHAR,
  SOURCE_ROWS     NUMBER,
  SILVER_ROWS     NUMBER,
  DIFFERENCE      NUMBER,
  VERDICT         VARCHAR
);

/* Baseline of the initial load, captured once per object. Reload detection
   compares against it: if the minimum watermark moves forward, SAP re-published
   the object instead of sending a delta. */
CREATE TABLE IF NOT EXISTS {{ T }}.CAPTURE_CONTROL.OBJECT_BASELINE (
  OBJECT_NAME            VARCHAR,
  FIRST_INITIAL_TS_TEXT  VARCHAR,
  ROWS_AT_BASELINE       NUMBER,
  CAPTURED_AT            TIMESTAMP_NTZ DEFAULT SYSDATE(),
  CONSTRAINT PK_OBJECT_BASELINE PRIMARY KEY (OBJECT_NAME)
);
