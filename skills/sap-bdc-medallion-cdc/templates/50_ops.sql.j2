/* ============================================================================
   50  Operations — validate, poll, refresh, monitor, reconcile
   ----------------------------------------------------------------------------
   Generated by sap-bdc-medallion-cdc from {{ config_name }}.

   The file that makes the pattern safe to leave running:
     1. VALIDATE the connector metadata before trusting it.
     2. POLL the watermark for free; refresh only when the source moved.
     3. DETECT a reload — incremental refresh stays correct while becoming as
        expensive as a full rebuild, and never raises an error.
     4. RECONCILE row counts — no delete code has been confirmed, so a hard
        delete in SAP would otherwise be invisible.

   The poll compares TEXT and never parses: MAX() over the raw watermark is
   answered from Iceberg manifest statistics; MAX() over a parsed expression
   reads the object.
   ========================================================================== */

USE DATABASE {{ T }};

/* ---------------------------------------------------------------------------
   1. Validation. One statement per object, generated from the registry.
{%- if src.track == 'STANDARD' %}
   USABLE requires: operation column of low cardinality (<=12) and short
   values (<=2 chars), timestamps that parse, operation <> timestamp on every
   row. HASH_SUFFIX_SEEN is evidence you are reading a live share, not a copy.
{%- else %}
   Custom track: no operation column, so validation checks that the
   replication timestamp is populated. NULL watermarks are rows capture can
   never see change.
{%- endif %}
   EMPTY is its own verdict so that UNUSABLE always means corrupt.
   --------------------------------------------------------------------------- */
CREATE OR REPLACE PROCEDURE CAPTURE_CONTROL.SP_VALIDATE_METADATA()
  RETURNS VARCHAR
  LANGUAGE SQL
  COMMENT = 'Validate connector metadata on every registered object before capture relies on it.'
AS
$$
DECLARE
  n_bad     NUMBER DEFAULT 0;
  v_started TIMESTAMP_NTZ DEFAULT SYSDATE();
BEGIN
{%- for o in objects %}
{%- if src.track == 'STANDARD' %}
  INSERT INTO CAPTURE_CONTROL.METADATA_VALIDATION
    (OBJECT_NAME, SOURCE_FQN, TRACK, TOTAL_ROWS, OPERATION_CARD, OPERATION_MAX_LEN,
     TIMESTAMPS_PARSED, DEGENERATE_ROWS, HASH_SUFFIX_SEEN, VERDICT, FAULTS)
  WITH M AS (
    SELECT COUNT(*) AS N,
           COUNT(DISTINCT "__OPERATION_TYPE") AS CARD,
           MAX(LENGTH("__OPERATION_TYPE"))    AS MAXLEN,
           COUNT(TRY_TO_TIMESTAMP_NTZ(REPLACE("__TIMESTAMP", ',', '.'))) AS TSOK,
           SUM(IFF("__OPERATION_TYPE" = "__TIMESTAMP"
                   OR "__OPERATION_TYPE" = "{{ src.load_type_col }}", 1, 0)) AS DEGEN
    FROM {{ o.source_fqn }})
  SELECT '{{ o.name }}', '{{ o.source_fqn | sqlstr }}', 'STANDARD', N, CARD, MAXLEN, TSOK, DEGEN,
         {{ 'TRUE' if src.hash_suffix_ok else 'FALSE' }},
         CASE WHEN N = 0 THEN 'EMPTY'
              WHEN COALESCE(CARD, 0) <= 12 AND COALESCE(MAXLEN, 0) <= 2
                   AND TSOK > 0 AND COALESCE(DEGEN, 0) = 0 THEN 'USABLE'
              ELSE 'UNUSABLE' END,
         NULLIF(TRIM(IFF(COALESCE(CARD, 0) > 12 OR COALESCE(MAXLEN, 0) > 2, 'operation column is not a change code; ', '')
                  || IFF(N > 0 AND TSOK = 0, 'timestamp column does not parse; ', '')
                  || IFF(COALESCE(DEGEN, 0) > 0, 'metadata columns hold the same value; ', '')), '')
  FROM M;
{%- else %}
  INSERT INTO CAPTURE_CONTROL.METADATA_VALIDATION
    (OBJECT_NAME, SOURCE_FQN, TRACK, TOTAL_ROWS, TIMESTAMPS_PARSED, VERDICT, FAULTS)
  WITH M AS (SELECT COUNT(*) AS N, COUNT("{{ src.watermark_column }}") AS TSOK FROM {{ o.source_fqn }})
  SELECT '{{ o.name }}', '{{ o.source_fqn | sqlstr }}', 'CUSTOM', N, TSOK,
         CASE WHEN N = 0 THEN 'EMPTY'
              WHEN TSOK = 0 THEN 'UNUSABLE'
              WHEN TSOK < N THEN 'USABLE_WITH_NULLS'
              ELSE 'USABLE' END,
         IFF(TSOK < N, (N - TSOK) || ' row(s) have no replication timestamp', NULL)
  FROM M;
{%- endif %}
{%- endfor %}

  /* Seed the reload baseline for any object that has none yet. */
{%- for o in objects %}
  INSERT INTO CAPTURE_CONTROL.OBJECT_BASELINE (OBJECT_NAME, FIRST_INITIAL_TS_TEXT, ROWS_AT_BASELINE)
  SELECT '{{ o.name }}', {{ o.poll_min_expr }}, COUNT(*)
  FROM {{ o.source_fqn }}
  WHERE NOT EXISTS (SELECT 1 FROM CAPTURE_CONTROL.OBJECT_BASELINE WHERE OBJECT_NAME = '{{ o.name }}')
  HAVING COUNT(*) > 0;
{%- endfor %}

  n_bad := (SELECT COUNT(*) FROM CAPTURE_CONTROL.METADATA_VALIDATION
            WHERE CHECKED_AT >= :v_started AND VERDICT = 'UNUSABLE');
  IF (:n_bad > 0) THEN
    RETURN 'UNUSABLE METADATA on ' || :n_bad || ' of {{ objects | length }} object(s). '
           || 'Inspect CAPTURE_CONTROL.METADATA_VALIDATION and do not build capture on the failing objects.';
  END IF;
  RETURN 'All {{ objects | length }} object(s) validated.';
END;
$$;


/* ---------------------------------------------------------------------------
   2. Poll one object, refresh its dynamic table only if the watermark moved.
   Registry-driven, so one unreadable source cannot stall the rest.
   --------------------------------------------------------------------------- */
CREATE OR REPLACE PROCEDURE CAPTURE_CONTROL.SP_POLL_OBJECT(P_OBJECT VARCHAR)
  RETURNS VARCHAR
  LANGUAGE SQL
  COMMENT = 'Refresh one registered object''s dynamic table only if its source watermark advanced.'
AS
$$
DECLARE
  src_fqn  VARCHAR;
  max_expr VARCHAR;
  tgt_dt   VARCHAR;
  src_wm   VARCHAR;
  seen_wm  VARCHAR;
  rs       RESULTSET;
BEGIN
  SELECT SOURCE_FQN, POLL_MAX_EXPR, TARGET_DT, LAST_WATERMARK_TEXT
    INTO src_fqn, max_expr, tgt_dt, seen_wm
    FROM CAPTURE_CONTROL.WATERMARK
   WHERE OBJECT_NAME = :P_OBJECT;

  IF (src_fqn IS NULL OR tgt_dt IS NULL) THEN
    RETURN 'NOT REGISTERED OR NO TARGET: ' || :P_OBJECT;
  END IF;

  /* A scalar out of dynamic SQL needs a RESULTSET and a cursor. */
  rs := (EXECUTE IMMEDIATE 'SELECT ' || :max_expr || ' AS M FROM ' || :src_fqn);
  LET cur CURSOR FOR rs;
  OPEN cur;
  FETCH cur INTO src_wm;
  CLOSE cur;

  IF (src_wm IS NULL) THEN
    UPDATE CAPTURE_CONTROL.WATERMARK SET LAST_RUN_STATUS = 'NO_SIGNAL', UPDATED_AT = SYSDATE()
     WHERE OBJECT_NAME = :P_OBJECT;
    RETURN 'NO SIGNAL (empty source or empty watermark): ' || :P_OBJECT;
  END IF;

  /* Text comparison: correct because the format is fixed-width and zero-padded. */
  IF (:seen_wm IS NULL OR :src_wm > :seen_wm) THEN
    EXECUTE IMMEDIATE 'ALTER DYNAMIC TABLE ' || :tgt_dt || ' REFRESH';
    UPDATE CAPTURE_CONTROL.WATERMARK
       SET LAST_WATERMARK_TEXT = :src_wm,
           LAST_WATERMARK      = TRY_TO_TIMESTAMP_NTZ(REPLACE(:src_wm, ',', '.')),
           LAST_RUN_STARTED    = SYSDATE(),
           LAST_RUN_STATUS     = 'REFRESHED',
           UPDATED_AT          = SYSDATE()
     WHERE OBJECT_NAME = :P_OBJECT;
    RETURN 'REFRESHED ' || :tgt_dt || ' to ' || :src_wm;
  END IF;

  UPDATE CAPTURE_CONTROL.WATERMARK SET LAST_RUN_STATUS = 'NO_CHANGE', UPDATED_AT = SYSDATE()
   WHERE OBJECT_NAME = :P_OBJECT;
  RETURN 'NO CHANGE at ' || :src_wm;
END;
$$;


CREATE OR REPLACE PROCEDURE CAPTURE_CONTROL.SP_CAPTURE_CYCLE()
  RETURNS VARCHAR
  LANGUAGE SQL
  COMMENT = 'One capture cycle: poll every populated object, refresh Gold if anything moved, snapshot the audit.'
AS
$$
DECLARE
  c_obj CURSOR FOR
    SELECT OBJECT_NAME FROM CAPTURE_CONTROL.WATERMARK
    WHERE OBJECT_CLASS <> 'EMPTY' ORDER BY OBJECT_NAME;
  n_refreshed NUMBER DEFAULT 0;
  n_polled    NUMBER DEFAULT 0;
  res         VARCHAR;
  v_object    VARCHAR;
BEGIN
  FOR rec IN c_obj DO
    n_polled := :n_polled + 1;
    /* Cursor fields must be bound to a variable before crossing into SQL. */
    v_object := rec.OBJECT_NAME;
    CALL CAPTURE_CONTROL.SP_POLL_OBJECT(:v_object);
    res := (SELECT LAST_RUN_STATUS FROM CAPTURE_CONTROL.WATERMARK WHERE OBJECT_NAME = :v_object);
    IF (res = 'REFRESHED') THEN
      n_refreshed := :n_refreshed + 1;
    END IF;
  END FOR;

  /* Gold is refreshed explicitly, in a visible order, only when Silver moved. */
  IF (:n_refreshed > 0) THEN
{%- for g in gold_dts %}
    ALTER DYNAMIC TABLE {{ g }} REFRESH;
{%- else %}
    NULL;  -- no Gold dynamic tables registered in the config
{%- endfor %}
  END IF;

  INSERT INTO CAPTURE_CONTROL.REFRESH_AUDIT
    (TARGET_DT, REFRESH_ACTION, STATE, REFRESH_START, REFRESH_END, DURATION_MS)
  SELECT QUALIFIED_NAME, REFRESH_ACTION, STATE, REFRESH_START_TIME, REFRESH_END_TIME,
         DATEDIFF('millisecond', REFRESH_START_TIME, REFRESH_END_TIME)
  FROM   TABLE({{ T }}.INFORMATION_SCHEMA.DYNAMIC_TABLE_REFRESH_HISTORY())
  WHERE  QUALIFIED_NAME ILIKE '{{ T }}.%'
    AND  REFRESH_END_TIME >= DATEADD('minute', -60, CURRENT_TIMESTAMP())
    AND  NOT EXISTS (SELECT 1 FROM CAPTURE_CONTROL.REFRESH_AUDIT a
                     WHERE a.TARGET_DT = QUALIFIED_NAME AND a.REFRESH_END = REFRESH_END_TIME);

  RETURN 'Polled ' || :n_polled || ' object(s), refreshed ' || :n_refreshed
         || IFF(:n_refreshed > 0, ', Gold rebuilt.', ', Gold untouched.');
END;
$$;


/* ---------------------------------------------------------------------------
   3. Reconciliation — source against Silver, per populated object. A
   difference means a delete the share never expressed, or a short merge key.
   --------------------------------------------------------------------------- */
CREATE OR REPLACE PROCEDURE CAPTURE_CONTROL.SP_RECONCILE()
  RETURNS VARCHAR
  LANGUAGE SQL
  COMMENT = 'Compare source row counts against Silver for every populated object.'
AS
$$
DECLARE
  c_obj CURSOR FOR
    SELECT OBJECT_NAME, SOURCE_FQN, TARGET_DT FROM CAPTURE_CONTROL.WATERMARK
    WHERE OBJECT_CLASS <> 'EMPTY';
  n_diff    NUMBER DEFAULT 0;
  v_started TIMESTAMP_NTZ DEFAULT SYSDATE();
BEGIN
  FOR rec IN c_obj DO
    EXECUTE IMMEDIATE
      'INSERT INTO CAPTURE_CONTROL.RECONCILIATION '
      || '(OBJECT_NAME, SOURCE_ROWS, SILVER_ROWS, DIFFERENCE, VERDICT) '
      || 'WITH S AS (SELECT COUNT(*) AS N FROM ' || rec.SOURCE_FQN || '), '
      || '     T AS (SELECT COUNT(*) AS N FROM ' || rec.TARGET_DT || ') '
      || 'SELECT ''' || rec.OBJECT_NAME || ''', S.N, T.N, S.N - T.N, '
      || '  IFF(S.N = T.N, ''MATCH'', ''DIFFERENCE'') FROM S, T';
  END FOR;
  n_diff := (SELECT COUNT(*) FROM CAPTURE_CONTROL.RECONCILIATION
             WHERE CHECKED_AT >= :v_started AND VERDICT = 'DIFFERENCE');
  IF (:n_diff > 0) THEN
    RETURN 'RECONCILIATION DIFFERENCE on ' || :n_diff || ' object(s). '
           || 'Either the share expressed a delete it did not label, or a merge key is short. '
           || 'Inspect CAPTURE_CONTROL.RECONCILIATION.';
  END IF;
  RETURN 'Reconciled: source and Silver agree on every object.';
END;
$$;


/* ---------------------------------------------------------------------------
   4. Monitoring views.
   --------------------------------------------------------------------------- */

/* SYSDATE() not CURRENT_TIMESTAMP(): the connector writes UTC and the watermark
   is NTZ; CURRENT_TIMESTAMP() is session-timezone aware and reports nonsense
   lags on non-UTC sessions. The one place the watermark is parsed. */
CREATE OR REPLACE VIEW CAPTURE_CONTROL.VW_FRESHNESS
  COMMENT = 'How far behind each registered object is, in minutes.'
AS
SELECT OBJECT_NAME, OBJECT_CLASS, SOURCE_FQN, TARGET_DT,
       COALESCE(LAST_WATERMARK, TRY_TO_TIMESTAMP_NTZ(REPLACE(LAST_WATERMARK_TEXT, ',', '.'))) AS LAST_WATERMARK_UTC,
       DATEDIFF('minute',
                COALESCE(LAST_WATERMARK, TRY_TO_TIMESTAMP_NTZ(REPLACE(LAST_WATERMARK_TEXT, ',', '.'))),
                SYSDATE())                                                         AS MINUTES_BEHIND,
       LAST_RUN_STATUS, LAST_RUN_STARTED, UPDATED_AT
FROM   CAPTURE_CONTROL.WATERMARK;

/* Reload detection. The pattern rests on the connector MERGING rather than
   reloading; if that changes nothing errors, the bill just grows. */
CREATE OR REPLACE VIEW CAPTURE_CONTROL.VW_RELOAD_DETECTION
  COMMENT = 'Flags objects that were re-published rather than sent as deltas.'
AS
WITH cur AS (
    SELECT OBJECT_NAME,
           SUM(ROWS_)                                AS TOTAL_ROWS,
           SUM(IFF(LOAD_TYPE = 'initial', ROWS_, 0)) AS INITIAL_ROWS,
           SUM(IFF(LOAD_TYPE = 'delta',   ROWS_, 0)) AS DELTA_ROWS,
           MIN(FIRST_SEEN)                           AS MIN_TS_TEXT,
           MAX(LAST_SEEN)                            AS MAX_TS_TEXT
    FROM   BRONZE.VW_SHARE_INVENTORY
    GROUP  BY OBJECT_NAME
)
SELECT c.OBJECT_NAME, c.TOTAL_ROWS, c.INITIAL_ROWS, c.DELTA_ROWS,
       b.FIRST_INITIAL_TS_TEXT AS BASELINE_TS_TEXT,
       c.MIN_TS_TEXT           AS CURRENT_MIN_TS_TEXT,
       c.MAX_TS_TEXT           AS CURRENT_MAX_TS_TEXT,
       CASE
         WHEN c.TOTAL_ROWS = 0                                                    THEN 'EMPTY'
         WHEN b.FIRST_INITIAL_TS_TEXT IS NOT NULL AND c.MIN_TS_TEXT > b.FIRST_INITIAL_TS_TEXT THEN 'RELOADED'
{%- if src.track == 'STANDARD' %}
         WHEN c.DELTA_ROWS = 0 AND c.INITIAL_ROWS = c.TOTAL_ROWS                  THEN 'SNAPSHOT_ONLY'
{%- endif %}
         ELSE 'MERGING'
       END AS VERDICT
FROM      cur c
LEFT JOIN CAPTURE_CONTROL.OBJECT_BASELINE b ON b.OBJECT_NAME = c.OBJECT_NAME;
{% if ri %}
/* Referential integrity: child rows whose key is absent from the master and
   are therefore not represented in a master-anchored Gold dimension. Makes
   that exclusion a reported number rather than a silent discrepancy. */
CREATE OR REPLACE VIEW CAPTURE_CONTROL.VW_REFERENTIAL_INTEGRITY
  COMMENT = 'Child rows whose {{ ri.key_list }} does not exist in {{ ri.master }}.'
AS
WITH m AS (SELECT DISTINCT {{ ri.key_select }} FROM SILVER.DT_{{ ri.master }})
{%- for ch in ri.children %}
SELECT '{{ ch }}' AS OBJECT_NAME,
       COUNT(*) AS ORPHAN_ROWS
FROM      SILVER.DT_{{ ch }} c
LEFT JOIN m ON {{ ri.join_on }}
WHERE     m.{{ ri.first_key }} IS NULL
{{- "\nUNION ALL" if not loop.last else ";" }}
{%- endfor %}
{% endif %}
/* INCREMENTAL is the design working, NO_DATA a free no-change cycle, FULL means
   the incremental path was abandoned. */
CREATE OR REPLACE VIEW CAPTURE_CONTROL.VW_REFRESH_HISTORY
  COMMENT = 'Dynamic table refresh outcomes for this database, newest first.'
AS
SELECT NAME, SCHEMA_NAME, REFRESH_ACTION, STATE, STATE_MESSAGE,
       REFRESH_START_TIME, REFRESH_END_TIME,
       DATEDIFF('millisecond', REFRESH_START_TIME, REFRESH_END_TIME) AS DURATION_MS,
       DATA_TIMESTAMP
FROM   TABLE({{ T }}.INFORMATION_SCHEMA.DYNAMIC_TABLE_REFRESH_HISTORY())
WHERE  DATABASE_NAME = '{{ T_plain }}';

/* The one object to look at each morning. */
CREATE OR REPLACE VIEW CAPTURE_CONTROL.VW_CAPTURE_HEALTH
  COMMENT = 'One row per object: freshness, last validation verdict, reload state and reconciliation.'
AS
SELECT f.OBJECT_NAME, f.OBJECT_CLASS, f.MINUTES_BEHIND, f.LAST_RUN_STATUS,
       v.VERDICT   AS METADATA_VERDICT, v.OPERATION_CARD, v.OPERATION_MAX_LEN, v.HASH_SUFFIX_SEEN,
       r.VERDICT   AS RELOAD_VERDICT,
       rc.SOURCE_ROWS, rc.SILVER_ROWS, rc.DIFFERENCE AS ROW_DIFFERENCE, rc.VERDICT AS RECONCILE_VERDICT
FROM       CAPTURE_CONTROL.VW_FRESHNESS f
LEFT JOIN (SELECT * FROM CAPTURE_CONTROL.METADATA_VALIDATION
           QUALIFY ROW_NUMBER() OVER (PARTITION BY OBJECT_NAME ORDER BY CHECKED_AT DESC) = 1) v
       ON v.OBJECT_NAME = f.OBJECT_NAME
LEFT JOIN CAPTURE_CONTROL.VW_RELOAD_DETECTION r ON r.OBJECT_NAME = f.OBJECT_NAME
LEFT JOIN (SELECT * FROM CAPTURE_CONTROL.RECONCILIATION
           QUALIFY ROW_NUMBER() OVER (PARTITION BY OBJECT_NAME ORDER BY CHECKED_AT DESC) = 1) rc
       ON rc.OBJECT_NAME = f.OBJECT_NAME;


/* ---------------------------------------------------------------------------
   5. Orchestration. The poll is free, so its interval is set by how quickly the
   business wants to see a change, not by scan cost. Both tasks are created
   SUSPENDED: a task that starts refreshing on deployment is a surprise.
   --------------------------------------------------------------------------- */
CREATE OR REPLACE TASK CAPTURE_CONTROL.TSK_CAPTURE_CYCLE
  WAREHOUSE = {{ WH }}
  SCHEDULE  = '{{ schedule.capture }}'
  COMMENT   = 'Poll the {{ src.database }} watermarks and refresh only what moved.'
AS
  CALL CAPTURE_CONTROL.SP_CAPTURE_CYCLE();

/* Wrapped in one procedure so the task body is a single CALL — clients that
   split scripts on semicolons would otherwise cut a BEGIN...END body in half. */
CREATE OR REPLACE PROCEDURE CAPTURE_CONTROL.SP_DAILY_ASSURANCE()
  RETURNS VARCHAR
  LANGUAGE SQL
  COMMENT = 'Re-validate connector metadata and reconcile row counts.'
AS
$$
DECLARE
  v_valid VARCHAR;
  v_recon VARCHAR;
BEGIN
  CALL CAPTURE_CONTROL.SP_VALIDATE_METADATA() INTO :v_valid;
  CALL CAPTURE_CONTROL.SP_RECONCILE()         INTO :v_recon;
  RETURN 'VALIDATE: ' || :v_valid || ' | RECONCILE: ' || :v_recon;
END;
$$;

CREATE OR REPLACE TASK CAPTURE_CONTROL.TSK_DAILY_ASSURANCE
  WAREHOUSE = {{ WH }}
  SCHEDULE  = '{{ schedule.assurance }}'
  COMMENT   = 'Daily: re-validate connector metadata and reconcile row counts.'
AS
  CALL CAPTURE_CONTROL.SP_DAILY_ASSURANCE();
